  {
    "id": 8,
    "title": "Recipe: Chocolate Chip Cookies",
    "content": {
      "type": "com.despicable.core.model.NoteContent.ChecklistItems",
      "items": [
        {
          "noteId": 8,
          "content": "Ingredients:",
          "position": 0,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "2 1/4 cups all-purpose flour",
          "position": 1,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "1 tsp baking soda",
          "position": 2,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "1 tsp salt",
          "position": 3,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "1 cup unsalted butter, softened",
          "position": 4,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "3/4 cup granulated sugar",
          "position": 5,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "3/4 cup brown sugar",
          "position": 6,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "2 large eggs",
          "position": 7,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "2 tsp vanilla extract",
          "position": 8,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "2 cups semisweet chocolate chips",
          "position": 9,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "Instructions:",
          "position": 10,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "Preheat oven to 375°F (190°C)",
          "position": 11,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "Mix flour, baking soda, and salt",
          "position": 12,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "Cream butter and sugars",
          "position": 13,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "Beat in eggs and vanilla",
          "position": 14,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "Stir in flour mixture",
          "position": 15,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "Fold in chocolate chips",
          "position": 16,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "Drop spoonfuls onto baking sheets",
          "position": 17,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "Bake for 9-11 minutes",
          "position": 18,
          "isChecked": false
        },
        {
          "noteId": 8,
          "content": "Cool on wire racks",
          "position": 19,
          "isChecked": false
        }
      ]
    },
